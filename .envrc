set -e

# --- Keep a venv at .venv
export VIRTUAL_ENV=.venv

# --- Python version: 3.14.10 is the oldest 3.14 with the eMudhra CA fix (CVE-2026-115557).
# Override with PYTHON_VERSION, but keep it at or above the patched release for that minor
# (3.11.18, 3.12.16, 3.13.18, 3.14.10).
PYTHON_VERSION="${PYTHON_VERSION:-3.14.10}"
echo "Using Python $PYTHON_VERSION"

if ! command -v uv >/dev/null 2>&1; then
  echo "Error: uv (>=0.13.6) is required to install Python $PYTHON_VERSION." >&2
  exit 1
fi

# --- Recreate venv if version inside .venv doesn't match desired
if [ -d ".venv" ]; then
  CURRENT_VERSION="$(.venv/bin/python --version 2>&1 | cut -d' ' -f2 || true)"
  if [ "$CURRENT_VERSION" != "$PYTHON_VERSION" ]; then
    echo "Current Python version ($CURRENT_VERSION) != desired ($PYTHON_VERSION). Recreating .venv ..."
    rm -rf .venv
  fi
fi

# --- Create the venv with a uv-managed interpreter so the patch level is exact
if [ ! -d ".venv" ]; then
  uv venv .venv --python "$PYTHON_VERSION" --managed-python --seed
fi

# --- Activate venv
source ./.venv/bin/activate

# --- Ensure tooling inside venv
python -m pip install -U 'pip>=26.2.2' 'uv>=0.13.6'

# --- Install the project + dev deps from the lockfile (uv.lock)
python -m uv sync --locked --group dev

# --- Load environment variables from .env (create from example if missing)
if [ ! -f .env ]; then
  cp .env.example .env
fi
dotenv

# --- Install pre-commit hooks
pre-commit install

# --- Python / Locale
export PYTHONDONTWRITEBYTECODE=1
export LC_ALL='en_US.UTF-8'
export LANG='en_US.UTF-8'
export LANGUAGE='en_US.UTF-8'

# --- PATH
path_add PATH "$(expand_path bin)"
