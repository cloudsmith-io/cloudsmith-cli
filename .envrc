set -e

# --- Install the tools pinned in mise.toml (Python, uv, Entire)
mise install
watch_file mise.toml mise.lock

# --- Recreate .venv when its Python differs from the version pinned in mise.toml
if [ -d ".venv" ]; then
  CURRENT_VERSION="$(.venv/bin/python --version 2>&1 | cut -d' ' -f2 || true)"
  if [ "$CURRENT_VERSION" != "$(mise current python)" ]; then
    echo "Current Python version ($CURRENT_VERSION) != pinned ($(mise current python)). Recreating .venv ..."
    rm -rf .venv
  fi
fi

# --- Put the mise tools on PATH and activate .venv (mise creates it)
mise_env="$(mise env -s bash)"
eval "$mise_env"

# --- Install the project + dev deps from the lockfile (uv.lock)
uv sync --locked --group dev

# --- Load environment variables from .env (create from example if missing)
if [ ! -f .env ]; then
  cp .env.example .env
fi
dotenv

# --- Install pre-commit hooks
pre-commit install

# --- Turn Entire on only for users who can read the private checkpoint repository.
# The committed settings turn Entire off, so other contributors get no Entire output.
# Entire trusts a checkpoint_remote in the untracked settings.local.json on every push.
# It can ignore the committed one and push to origin, which is public.
checkpoint_url="$(git remote get-url origin 2>/dev/null | sed -E 's#[^/:]+/[^/]+$#cloudsmith-io/cloudsmith-cli-checkpoints.git#')"
if grep -q '"enabled": true' .entire/settings.local.json 2>/dev/null ||
  GIT_TERMINAL_PROMPT=0 GIT_SSH_COMMAND="ssh -o BatchMode=yes -o ConnectTimeout=5" git ls-remote "$checkpoint_url" >/dev/null 2>&1; then
  python - <<'PY'
import json
import pathlib

path = pathlib.Path(".entire/settings.local.json")
settings = json.loads(path.read_text()) if path.exists() else {}
newly_enabled = settings.get("enabled") is not True
settings["enabled"] = True
options = settings.setdefault("strategy_options", {})
options["checkpoint_remote"] = {"provider": "github", "repo": "cloudsmith-io/cloudsmith-cli-checkpoints"}
if newly_enabled:
    options["push_sessions"] = True
path.write_text(json.dumps(settings, indent=2) + "\n")
PY
fi

# --- Entire plugins are per user and live outside mise, at the path Brain's
# watcher service and git hook run from. Only the install is automatic:
# `entire brain setup` installs that service and can spend agent tokens.
plugin_bin=${ENTIRE_PLUGIN_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/entire/plugins}/bin
if grep -q '"enabled": true' .entire/settings.local.json 2>/dev/null && ! test -x "$plugin_bin/entire-brain"; then
  entire plugin install brain --yes &&
    log_status "Installed Entire Brain: run 'entire brain setup && entire brain connect' to build this repository's brain and pull its shared memories"
fi

# --- Python / Locale
export PYTHONDONTWRITEBYTECODE=1
export LC_ALL='en_US.UTF-8'
export LANG='en_US.UTF-8'
export LANGUAGE='en_US.UTF-8'

# --- PATH
path_add PATH "$(expand_path bin)"
